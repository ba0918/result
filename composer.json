{
    "name": "mizumi/result",
    "autoload": {
        "psr-4": {
            "Mizumi\\Result\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2",
        "friendsofphp/php-cs-fixer": "^3.82"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "fix": [
            "@cs-fix"
        ]
    }
}
