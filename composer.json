{
    "name": "ba0918/result",
    "description": "Rust-inspired Result and Option types for PHP, with immutable design and full type safety",
    "license": "MIT",
    "authors": [
        {
            "name": "ba0918"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "ba0918\\Result\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2",
        "friendsofphp/php-cs-fixer": "^3.82",
        "infection/infection": "*"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "fix": [
            "@cs-fix"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
