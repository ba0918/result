# EditorConfig is awesome: https://EditorConfig.org

# このファイルがプロジェクトのルートであることを示す
root = true

[*]
# 全てのファイルに適用される基本設定
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.php]
# PHPファイルにはインデントサイズ4のスペースを使用 (PSR-12準拠)
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,html,css,scss,json,yml,yaml}]
# Web関連ファイルや設定ファイルはインデントサイズ2をよく使う
indent_size = 2

[*.md]
# Markdownファイルでは意図的な行末スペースが意味を持つことがあるため、
# 自動トリムを無効にすることもある
trim_trailing_whitespace = false
